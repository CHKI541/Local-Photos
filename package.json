{
  "name": "local-photos",
  "version": "2.1.0",
  "description": "Galería de fotos y videos locales, 100% offline.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "exif-parser": "^0.1.12",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.34.0"
  },
  "build": {
    "appId": "com.israel.localphotos",
    "productName": "Local Photos",
    "files": [
      "**/*",
      "!_backup*",
      "!_to_delete/**",
      "!_rev/**",
      "!CAMBIOS_REALIZADOS.md",
      "!HANDOFF_*.md",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
